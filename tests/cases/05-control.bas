10 FOR I=1 TO 10 STEP 3:PRINT I;:NEXT:PRINT
20 FOR I=5 TO 1 STEP -2:PRINT I;:NEXT I:PRINT
30 FOR I=1 TO 2:FOR J=1 TO 2:PRINT I*10+J;:NEXT J,I:PRINT
40 GOSUB 100:PRINT "BACK"
50 FOR K=1 TO 3:ON K GOTO 60,70,80
60 PRINT "ONE":GOTO 90
70 PRINT "TWO":GOTO 90
80 PRINT "THREE"
90 NEXT K
95 IF 1=1 THEN PRINT "T" ELSE PRINT "F"
96 IF 1=2 THEN PRINT "T" ELSE PRINT "F"
97 IF 0 THEN 99
98 PRINT "FELL THROUGH":END
99 PRINT "WRONG"
100 PRINT "SUB":RETURN
RUN
