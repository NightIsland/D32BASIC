5 CLEAR 3000
10 DIM A$(50)
20 FOR I=1 TO 50:A$(I)=STRING$(I,"X")+STR$(I):NEXT
30 FOR J=1 TO 20:FOR I=1 TO 50:A$(I)=MID$(A$(I),2)+LEFT$(A$(I),1):NEXT I,J
40 PRINT A$(1);"/";A$(25);"/";LEN(A$(50))
50 B$="":FOR I=1 TO 300:B$=RIGHT$(B$+CHR$(65+I MOD 26),20):NEXT:PRINT B$
60 C$="ABC":D$=C$:MID$(D$,2)="ZZZZ":PRINT C$;D$
70 PRINT INSTR(1,"ABCABC","CA");INSTR(5,"ABCABC","C");INSTR(7,"ABC","");INSTR("","")
80 PRINT ASC(CHR$(200));LEN(STR$(-1.5));VAL("1E3");VAL("&H10")
90 PRINT "A" < "AB";"B" > "AB";"" = "";"ABC" <> "ABD"
100 X$=STRING$(255,"Q"):PRINT LEN(X$+"")
110 Y$=X$+"Z"
RUN
PRINT MID$("HELLO",0)
PRINT LEFT$("HELLO",0);"!";RIGHT$("HI",9)
