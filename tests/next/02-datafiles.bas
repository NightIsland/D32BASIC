10 OPEN "O",#-1,"DATA"
20 FOR I=1 TO 3:PRINT #-1,I;",ITEM,";I*2:NEXT
30 PRINT #-1,"HELLO, WORLD"
40 CLOSE #-1
50 OPEN "I",#-1,"DATA"
60 IF EOF(-1) THEN 100
70 INPUT #-1,A,B$,C:PRINT A;B$;C;EOF(-1)
75 IF A=3 THEN LINE INPUT #-1,L$:PRINT "[";L$;"]"
80 GOTO 60
100 CLOSE:PRINT "DONE"
110 OPEN "I",#-1,"DATA":INPUT #-1,A:INPUT #-1,A,B,C
RUN
PRINT EOF(0)
OPEN "I",#-1,"NOPE"
CLOSE
OPEN "O",#-1,"X":OPEN "O",#-1,"Y"
PRINT #-2,"PRINTER":PRINT #-3,1
PRINT #-1,"A":CLOSE:INPUT #-1,A
OPEN "X",#-1,"Z"
PRINT "PRINTER OK"
LLIST
PRINT "LLIST OK"
